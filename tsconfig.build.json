{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "esnext.array", "esnext.collection", "esnext.error", "esnext.iterator", "esnext.promise", "dom"],
    "declaration": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
